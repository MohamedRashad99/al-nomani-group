rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /companies/{companyId}/uploads/{fileName} {
      allow read: if request.auth != null && companyId == 'al_nomani';
      allow write: if request.auth != null
        && companyId == 'al_nomani'
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf|application/json|text/.*');
    }
  }
}
